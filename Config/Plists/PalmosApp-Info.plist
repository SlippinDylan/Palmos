<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>Palmos</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSUIElement</key>
    <true/>
    <key>PalmosUpdateChannel</key>
    <string>$(PALMOS_UPDATE_CHANNEL)</string>
    <key>PalmosUpdaterEnabled</key>
    <string>$(PALMOS_UPDATER_ENABLED)</string>
    <key>SMPrivilegedExecutables</key>
    <dict>
        <key>com.palmos.smartservice</key>
        <string>anchor apple generic and certificate leaf[subject.OU] = "$(TEAM_IDENTIFIER)" and identifier "$(HELPER_BUNDLE_IDENTIFIER)"</string>
    </dict>
    <key>SUAutomaticallyUpdate</key>
    <true/>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUFeedURL</key>
    <string>https://slippindylan.github.io/homebrew-tap/palmos/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>EagyaGi+/pVuyXbZArnqGZ1g4QzJNYvRrrW1//SHfJ8=</string>
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
</dict>
</plist>
